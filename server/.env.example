# Copy to .env and fill in. Never commit .env.

# Port the server listens on. PaaS platforms set PORT for you.
PORT=8080

# Where SQLite and uploaded files live. On a PaaS, point this at a persistent volume.
DATA_DIR=./data

# A long random secret. Required for the admin site and owner-only endpoints.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OWNER_KEY=change-me-to-a-long-random-secret

# The public HTTPS base the mod and browsers reach this server at. Used to build file URLs.
# Local dev: http://localhost:8080  •  Production: https://your-domain
PUBLIC_BASE=http://localhost:8080

# Optional: a Discord webhook URL that reports are forwarded to (kept server-side only).
DISCORD_WEBHOOK=
